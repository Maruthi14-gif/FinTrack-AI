# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored: never commit real secrets.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (free M0 cluster works)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fintrack

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed to call this API, comma-separated, no trailing slash
CLIENT_URL=http://localhost:5173

# Google Gemini key (free tier): https://aistudio.google.com/apikey
# Optional: without it the app uses its offline fallbacks.
GEMINI_API_KEY=

# Web Push keys. Generate once with:  npx web-push generate-vapid-keys
# Optional locally, required in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
